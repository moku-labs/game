{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "p4-ui",
    "paths": {
      "p4-ui/jsx-runtime": ["./ui/jsx-runtime.ts"],
      "p4-ui/jsx-dev-runtime": ["./ui/jsx-dev-runtime.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "ui/*.ts"],
  "exclude": ["mistakes.tsx", "node_modules"]
}
