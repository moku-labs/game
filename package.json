{
  "name": "@moku-labs/game",
  "version": "0.13.0",
  "description": "2D puzzle game engine on TypeScript and PixiJS, built on @moku-labs/core.",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./app": {
      "types": "./dist/app.d.mts",
      "default": "./dist/app.mjs"
    },
    "./app/page": {
      "types": "./dist/app/page.d.mts",
      "default": "./dist/app/page.mjs"
    },
    "./app/system": {
      "types": "./dist/app/system.d.mts",
      "default": "./dist/app/system.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./visual": {
      "types": "./dist/visual.d.mts",
      "default": "./dist/visual.mjs"
    },
    "./assets": {
      "types": "./dist/assets.d.mts",
      "default": "./dist/assets.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "default": "./dist/inspect.mjs"
    },
    "./control": {
      "types": "./dist/control.d.mts",
      "default": "./dist/control.mjs"
    },
    "./hot": {
      "types": "./dist/hot.d.mts",
      "default": "./dist/hot.mjs"
    },
    "./lint": {
      "types": "./dist/lint.d.mts",
      "default": "./dist/lint.mjs"
    },
    "./project": {
      "types": "./dist/project.d.mts",
      "default": "./dist/project.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./fonts/*": "./fonts/*"
  },
  "bin": {
    "moku-game": "./bin/moku-game.mjs",
    "moku-game-assets": "./bin/moku-game-assets.mjs",
    "moku-game-index": "./bin/moku-game-index.mjs"
  },
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "fonts",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/game.git"
  },
  "homepage": "https://github.com/moku-labs/game#readme",
  "bugs": {
    "url": "https://github.com/moku-labs/game/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:coverage": "bun --bun vitest run --project unit --project integration --coverage",
    "build": "tsdown",
    "mini:pack": "bun tests/fixtures/moku-game.ts pack --root tests/fixtures/mini-game",
    "mini:dev": "bun tests/fixtures/moku-game.ts dev --root tests/fixtures/mini-game",
    "mini:visual": "bun tests/visual/run.ts",
    "validate": "publint && (attw --pack . --profile esm-only --quiet || attw --pack . --profile esm-only)",
    "release:setup": "moku-release setup",
    "release:doctor": "moku-release doctor",
    "release": "moku-release"
  },
  "dependencies": {
    "immer": "11.1.18",
    "maxrects-packer": "2.7.3",
    "yoga-layout": "3.2.1"
  },
  "peerDependencies": {
    "@moku-labs/common": "^0.3.4",
    "@moku-labs/core": "^1.7.1",
    "@moku-labs/native": "^0.3.2",
    "@moku-labs/system": "^0.3.1",
    "pixi.js": "^8.0.0",
    "playwright-core": ">=1.50.0",
    "sharp": "^0.34.0",
    "typescript": ">=5.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@moku-labs/native": {
      "optional": true
    },
    "@moku-labs/system": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@arethetypeswrong/core": "0.18.3",
    "@biomejs/biome": "2.4.16",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@moku-labs/ci": "1.3.0",
    "@moku-labs/common": "0.3.4",
    "@moku-labs/core": "1.7.1",
    "@moku-labs/native": "0.3.2",
    "@moku-labs/system": "0.3.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "lefthook": "2.1.1",
    "oxlint": "1.86.0",
    "pixi.js": "8.21.0",
    "playwright-core": "1.60.0",
    "publint": "0.3.21",
    "sharp": "0.34.5",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.0.18"
  }
}
