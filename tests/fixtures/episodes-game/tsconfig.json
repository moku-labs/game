{
  // The episodes game's own compiler options: the type options of the repo's tsconfig.json, and
  // the paths of a game in the v15 layout. Standalone, with no `extends`, so a copy of the folder
  // never points at a missing base. `bun run typecheck` compiles the game and its tests with it,
  // and Bun reads it when the asset scanner imports features/episodes/ep01/assets.ts.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "@moku-labs/game",
    "paths": {
      "@core/*": ["./core/*"],
      "@features": ["./features/index.ts"],
      "@features/*": ["./features/*/index.ts"],
      "@generated/*": ["./generated/*"],
      "@moku-labs/game": ["../../../src/index.ts"],
      "@moku-labs/game/testing": ["../../../src/testing.ts"],
      "@moku-labs/game/app": ["../../../src/app.ts"],
      "@moku-labs/game/app/page": ["../../../src/app/page.ts"],
      "@moku-labs/game/app/system": ["../../../src/app/system.ts"],
      "@moku-labs/game/cli": ["../../../src/cli.ts"],
      "@moku-labs/game/visual": ["../../../src/visual.ts"],
      "@moku-labs/game/inspect": ["../../../src/inspect.ts"],
      "@moku-labs/game/control": ["../../../src/control.ts"],
      "@moku-labs/game/hot": ["../../../src/hot.ts"],
      "@moku-labs/game/lint": ["../../../src/lint.ts"],
      "@moku-labs/game/project": ["../../../src/project.ts"],
      "@moku-labs/game/jsx-runtime": ["../../../src/jsx-runtime.ts"],
      "@moku-labs/game/jsx-dev-runtime": ["../../../src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../integration/*episodes*"],
  "exclude": [".moku", "dist"]
}
